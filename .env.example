# Telegram Bot Token from @BotFather (e.g. 123456789:ABCDefghIJKLMnopQRStuvWxyz)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Admin Telegram IDs (Comma separated if multiple, e.g. 12345678,87654321)
# To find your ID, message @userinfobot or @raw_data_bot on Telegram
ADMIN_IDS=123456789

# Database Path
DB_PATH=bot_database.db
